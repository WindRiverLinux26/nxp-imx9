2.3 imx-boot build
------------------

2.3.1 iMX93 Configuration
-------------------------
# u-boot
IMAGE_INSTALL:append = " imx-boot"

PREFERRED_PROVIDER_virtual/bootloader:mx9-nxp-bsp = "u-boot-imx"
CUSTOMER_RECIPES:fsl-bsp-release += 'u-boot-imx'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-atf'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-boot'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-mkimage'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-boot-firmware-files'
CUSTOMER_RECIPES:fsl-bsp-release += 'firmware-ele-imx'
IMX_EXTRA_FIRMWARE:mx93-generic-bsp = "imx-boot-firmware-files firmware-ele-imx"
SECOEXT_FIRMWARE_NAME:mx93-generic-bsp   ?= "mx93${IMX_SOC_REV_LOWER}-ahab-container.img"

CUSTOMER_BUILD_BOOTLOADER = "1"

IMX_SOC_REV:mx93-generic-bsp  = "A1"
IMX_SOC_REV_UPPER   = "${@d.getVar('IMX_SOC_REV').upper()}"
IMX_SOC_REV_LOWER   = "${@d.getVar('IMX_SOC_REV').lower()}"
SECO_FIRMWARE_NAME:mx93-generic-bsp   ?= "mx93${IMX_SOC_REV_LOWER}-ahab-container.img"

# For iMX93-EVK

KERNEL_DEVICETREE_BASENAME = "imx93-11x11-evk"

KERNEL_DEVICETREE:append:use-nxp-bsp = " \
    freescale/${KERNEL_DEVICETREE_BASENAME}-aud-hat.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-boe-wxga-lvds-panel.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-flexio-i2c.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-flexspi-m2.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-i3c.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-i2c-spi-slave.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-lpuart.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-mqs.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-mt9m114.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-rm67199.dtb \
 "

UBOOT_CONFIG_BASENAME = "imx93_11x11_evk"

# For iMX93-FRDM imx-boot

KERNEL_DEVICETREE_BASENAME = "imx93-11x11-frdm"

KERNEL_DEVICETREE:append:use-nxp-bsp = " \
    freescale/${KERNEL_DEVICETREE_BASENAME}-8mic-reve.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-aud-hat.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-ld.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-lpuart.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-mt9m114.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-ov5640.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-tianma-wvga-panel.dtb \
    freescale/${KERNEL_DEVICETREE_BASENAME}-waveshare-7inch-c-panel.dtb \
 "

UBOOT_CONFIG_BASENAME = "imx93_11x11_frdm"

DDR_FIRMWARE_NAME = " \
    lpddr4_dmem_1d_v202201.bin \
    lpddr4_dmem_2d_v202201.bin \
    lpddr4_imem_1d_v202201.bin \
    lpddr4_imem_2d_v202201.bin \
"
KERNEL_DEVICETREE = " \
    freescale/${KERNEL_DEVICETREE_BASENAME}.dtb \
"
UBOOT_DTB_NAME = "${KERNEL_DEVICETREE_BASENAME}.dtb"

IMX_DEFAULT_BOOTLOADER:use-nxp-bsp = "u-boot-imx"
IMX_DEFAULT_BOOTLOADER:use-mainline-bsp = "u-boot-fslc"

LOADADDR = ""
UBOOT_SUFFIX = "bin"
UBOOT_MAKE_TARGET = ""

SPL_BINARY = "spl/u-boot-spl.bin"

UBOOT_CONFIG ??= "mx93evk"
UBOOT_CONFIG[mx93evk]   = "${UBOOT_CONFIG_BASENAME}_defconfig,sdcard"

# Set ATF platform name
ATF_PLATFORM = "imx93"

IMXBOOT_TARGETS = "flash_singleboot"

IMX_BOOT_SOC_TARGET = "iMX9"
IMX_BOOT_SEEK = "32"

# We have to disable SERIAL_CONSOLE due to auto-serial-console
SERIAL_CONSOLES = "115200;ttyLP0"

IMX_DEFAULT_BSP = "nxp"

2.3.2 iMX95 Configuration
-------------------------

CUSTOMER_BUILD_BOOTLOADER = "1"
PREFERRED_PROVIDER_virtual/bootloader:mx9-nxp-bsp = "u-boot-imx"
CUSTOMER_RECIPES:fsl-bsp-release += 'u-boot-imx'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-atf'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-boot'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-mkimage'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-boot-firmware-files'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-system-manager'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-oei'
CUSTOMER_RECIPES:fsl-bsp-release += 'firmware-ele-imx'
CUSTOMER_RECIPES:fsl-bsp-release += 'gcc-arm-none-eabi-native'

IMAGE_INSTALL:append = " imx-boot"

KERNEL_DEVICETREE_BASENAME = "imx95-19x19-verdin"
UBOOT_DTB_NAME = "${KERNEL_DEVICETREE_BASENAME}.dtb"

UBOOT_CONFIG_BASENAME = "imx95_19x19_verdin"

UBOOT_CONFIG ??= "mx95evk"
UBOOT_CONFIG[mx95evk]    = "${UBOOT_CONFIG_BASENAME}_defconfig"

IMX_BOOT_SOC_TARGET = "iMX95"
IMXBOOT_TARGETS = "flash_a55"

IMXBOOT_TARGETS_BASENAME = "flash"
ATF_PLATFORM = "imx95"
OEI_CONFIGS = "ddr tcm"
OEI_CORE   = "m33"
OEI_SOC    = "mx95"
OEI_BOARD  ?= "mx95lp5"
DDR_TYPE   ?= "lpddr5"

SYSTEM_MANAGER_CONFIG = "mx95evk"

DDR_FIRMWARE_NAME = " \
    lpddr5_dmem_v202409.bin \
    lpddr5_dmem_qb_v202409.bin \
    lpddr5_imem_v202409.bin \
    lpddr5_imem_qb_v202409.bin \
"

IMXBOOT_VARIANT = ""
M4_DEFAULT_IMAGE_MX95:imx-nxp-bsp = "imx95-verdin-evk_m7_TCM_power_mode_switch.bin"

WKS_FILE_DEPENDS:append:imx-nxp-bsp = " imx-m7-demos"

IMAGE_BOOT_FILES:append:imx-nxp-bsp = " \
    mcore-demos/imx95-verdin-evk_m7_TCM_power_mode_switch.bin \
    mcore-demos/imx95-verdin-evk_m7_TCM_rpmsg_lite_pingpong_rtos_linux_remote.bin \
    mcore-demos/imx95-verdin-evk_m7_TCM_rpmsg_lite_str_echo_rtos.bin \
    mcore-demos/imx95-verdin-evk_m7_TCM_sai_low_power_audio.bin \
    ${@bb.utils.contains('COMBINED_FEATURES', 'xen', 'xen', '', d)} \
"
SYSTEM_MANAGER_FIRMWARE_BASENAME ?= "m33_image"
SYSTEM_MANAGER_FIRMWARE_NAME     ?= "m33_image-mx95evk"

IMX_EXTRA_FIRMWARE:mx95-nxp-bsp = "imx-boot-firmware-files firmware-ele-imx ${SYSTEM_MANAGER_RPROVIDER} imx-oei"

SYSTEM_MANAGER_RPROVIDER ?= "imx-system-manager"

IMX_SOC_REV_UPPER= "A0"
IMX_SOC_REV_LOWER = "a0"
AHAB_IMG = "SECO_FIRMWARE_NAME"
SECO_FIRMWARE_NAME:mx95-generic-bsp   ?= "mx95${IMX_SOC_REV_LOWER}-ahab-container.img"
SECOEXT_FIRMWARE_NAME ?= "UNDEFINED"
SPL_BINARY = "spl/u-boot-spl.bin"

2.4 BT/WIFI
------------

There is an official recommended BT/WIFI module(LBES5PL2EL, NXP IW612 chipset) for imx93-evk board.

2.4.1 WIFI
----------

1) Building WIFI related packages

Add below contents into local.conf to support for WIFI feature.

CUSTOMER_RECIPES:freescale-layer += "kernel-module-nxp-wlan"
CUSTOMER_RECIPES:fsl-bsp-release += "wireless-tools"
CUSTOMER_RECIPES:fsl-bsp-release += "nxp-wlan-sdk"
CUSTOMER_RECIPES:freescale-layer += "firmware-nxp-wifi"
CUSTOMER_RECIPES:fsl-bsp-release += "imx-m7-demos"
MACHINE_FEATURES:append:nxp-imx9 = " nxpwifi-all-pcie nxpwifi-all-sdio"

IMAGE_INSTALL:append = " kernel-module-nxp-wlan connman firmware-nxp-wifi-all-sdio firmware-nxp-wifi-all-pcie udev-extraconf firmware-nxp-wifi-nxpiw612-sdio"

MACHINE_FIRMWARE:append:nxp-imx9 = " firmware-nxp-wifi-all-sdio"
MACHINE_FIRMWARE:append:nxp-imx9 = " firmware-nxp-wifi-all-pcie"

3) Run WIFI feature

After system boots up, run below commands

	# modprobe mlan
	# modprobe moal mod_para=nxp/wifi_mod_para.conf
	# ifconfig mlan0 up
	# ifconfig uap0 up
	# iw dev mlan0 scan
	# ifconfig wlxa0cdf3780043 up
	# ifconfig wlxa2cdf3780143 up
	# iw dev wlxa0cdf3780043 scan
	# iw wlxa0cdf3780043 connect <AP essid>
	# dhcpcd wlxa0cdf3780043
	# ping <AP address> -I wlxa0cdf3780043 -c 5

2.4.2 BT
--------

Note: Switch SW1_1 on the back of the carrier board to ON to enable BT.(i.MX95 Only)

After system boots up, run below commands to run BT feature

	# modprobe btnxpuart
	# hciconfig hci0 up
	# hcitool -i hci0 scan
	List devices BT MAC address scaned

	# hcitool dc <BT MAC address>
	# hcitool cc <BT MAC address>
	# hcitool con
	# l2ping -c 5 <BT MAC address>

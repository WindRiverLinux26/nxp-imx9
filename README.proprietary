CUSTOMER_RECIPES:fsl-bsp-release += 'gstreamer1.0-plugins-good'
CUSTOMER_RECIPES:fsl-bsp-release += 'gstreamer1.0'
CUSTOMER_RECIPES:fsl-bsp-release += 'gstreamer1.0-plugins-bad'
CUSTOMER_RECIPES:fsl-bsp-release += 'gstreamer1.0-plugins-base'
PREFERRED_VERSION_gstreamer1.0:mx9-nxp-bsp  ??= "1.26.6.imx"
PREFERRED_VERSION_gstreamer1.0-plugins-bad:mx9-nxp-bsp  ??= "1.26.6.imx"
PREFERRED_VERSION_gstreamer1.0-plugins-good:mx9-nxp-bsp  ??= "1.26.6.imx"
PREFERRED_VERSION_gstreamer1.0-plugins-base:mx9-nxp-bsp  ??= "1.26.6.imx"

<2> startup we will find that weston starts under g2d acceleration

2.1.1 Gstreamer plug-in for PXP (iMX93 Only)
--------------------------------------------

<1> Composition

	gst-launch-1.0 -v imxcompositor_pxp name=comp sink_0::xpos=0 sink_0::ypos=0 sink_0::width=1280 sink_0::height=800 ! waylandsink videotestsrc ! comp.sink_0

<2> Color conversion

	gst-launch-1.0 videotestsrc ! video/x-raw, format=I420, width=640, height=480 ! imxvideoconvert_pxp ! queue ! waylandsink

<3> Scaling

	gst-launch-1.0 videotestsrc ! video/x-raw,width=1280,height=720 ! imxvideoconvert_pxp ! video/x-raw, width=1920, height=1080 ! waylandsink

<4> Rotation

	gst-launch-1.0 videotestsrc ! video/x-raw,format=NV16 ! imxvideoconvert_pxp rotation=4 ! fpsdisplaysink

<5> Alpha blending

	gst-launch-1.0 -v imxcompositor_pxp background=0x00000000 name=comp sink_0::alpha=0.8 \
	sink_1::alpha=0.4 sink_0::xpos=0 sink_0::ypos=0 sink_0::width=320 sink_0::height=240 \
	sink_1::xpos=120 sink_1::ypos=160 sink_1::width=480 sink_1::height=320 ! waylandsink videotestsrc ! \
	comp.sink_0 videotestsrc ! comp.sink_1

2.1.2 iMX95 os08a20
-------------------

Note. iMX95 use libcamera test os08a20 raw camera

cam --camera 1 --stream width=3840,height=2160,pixelformat=SBGGR12 \
	--capture=20 --file=picture.raw

2.1.3 iMX95 VPU
---------------

# Add the following content after the graphics configuration
IMAGE_INSTALL:append = " firmware-imx-vpu-wave"
MACHINE_FIRMWARE:append:mx95-nxp-bsp  = " firmware-imx-vpu-wave"
CUSTOMER_RECIPES:fsl-bsp-release += "firmware-imx"

H264 Encode:
	gst-launch-1.0 videotestsrc num-buffers=300 ! \
		"video/x-raw,format=YUY2,width=3840,height=2160,framerate=60/1" \
		! v4l2h264enc ! queue ! h264parse ! qtmux ! filesink location=yuv2h264.mp4

H264 Decode:
	gst-launch-1.0 filesrc \
		location=${PATH}/yuv2h264.mp4 typefind=true ! video/quicktime ! \
		aiurdemux name=demux demux. ! queue ! h264parse ! v4l2h264dec ! waylandsink

H265 Encode:
	gst-launch-1.0 videotestsrc num-buffers=300 ! \
		"video/x-raw,format=YUY2,width=3840,height=2160,framerate=60/1" \
		! v4l2h265enc ! queue ! h265parse ! qtmux ! filesink location=yuv2h265.mp4

H265 Decode:
	gst-launch-1.0 filesrc \
		location=${PATH}/yuv2h265.mp4 typefind=true ! video/quicktime ! \
		aiurdemux name=demux demux. ! queue ! h265parse ! v4l2h265dec ! waylandsink


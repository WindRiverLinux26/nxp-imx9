PREFERRED_VERSION_libdisplay-info = "0.1.1"

CUSTOMER_RECIPES:multimedia-layer += 'fdk-aac'
CUSTOMER_RECIPES:multimedia-layer += 'libfreeaptx'
CUSTOMER_RECIPES:multimedia-layer += 'pipewire'

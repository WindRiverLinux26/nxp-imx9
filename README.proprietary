1.0 common configuration
------------------------
# All private packages of imx require the following configuration
BB_NO_NETWORK = '0'
ACCEPT_FSL_EULA = "1"
LICENSE_FLAGS_ACCEPTED:append = " commercial"

CUSTOMER_RECIPES:fsl-bsp-release += 'imx-m33-demos'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-m7-demos'
BSP_NXP_DERIVED:append:nxp-imx9  = " nxp-imx9"
DISTROOVERRIDES:nxp-imx9 = "fsl fslc"

1.1 iMX9 OVERRIDES
------------------

iMX93 OVERRIDES:
    MACHINEOVERRIDES:prepend:nxp-imx9 = "imx-generic-bsp:imx-nxp-bsp:imxdrm:imxpxp:mx9-generic-bsp:mx9-nxp-bsp:mx93-generic-bsp:mx93-nxp-bsp:use-nxp-bsp:"

iMX95 OVERRIDES:
    MACHINEOVERRIDES:prepend:nxp-imx9 = " mx95:imx-generic-bsp:imx-nxp-bsp:imxdrm:imxdpu:imxgpu:imxgpu2d:imxgpu3d:mx9-generic-bsp:mx9-nxp-bsp:mx95-generic-bsp:mx95-nxp-bsp:use-nxp-bsp:"

2.1 GPU
-------
Because of the licesen issue, nxp-imx9 layer doesn't integrate imx9's PXP hardware
acceleration related packages into WRlinux product. So, if customer wants to run
hardware graphic feature. Detail steps as below:

<1> echo the following content to local.conf:

# If iMX93 board
	IMAGE_INSTALL:append = "  weston weston-init imx-pxp-g2d imx-g2d-samples weston-xwayland mesa-demos gstreamer1.0 gstreamer1.0-plugins-good gstreamer1.0-plugins-bad imx-gst1.0-plugin vulkan-headers vulkan-loader gstreamer1.0-plugins-base-videotestsrc"

# If iMX95 board
	IMAGE_INSTALL:append = "  weston weston-init imx-g2d-samples weston-xwayland gstreamer1.0 gstreamer1.0-plugins-good gstreamer1.0-plugins-bad imx-gst1.0-plugin mali-imx gstreamer1.0-plugins-base-videotestsrc libcamera glmark2 vulkan-headers vulkan-loader"

	PREFERRED_PROVIDER_virtual/libgl:imxgpu   ?= "mesa-gl"
	PREFERRED_PROVIDER_virtual/libgl:imxgpu3d  = "mesa-gl"
	PREFERRED_PROVIDER_virtual/mesa:imxgpu    ?= "mesa-gl"
	PREFERRED_PROVIDER_virtual/egl:mx95-nxp-bsp        ?= "mali-imx"
	PREFERRED_PROVIDER_virtual/libgles1:mx95-nxp-bsp   ?= "mali-imx"
	PREFERRED_PROVIDER_virtual/libgles2:mx95-nxp-bsp   ?= "mali-imx"
	PREFERRED_PROVIDER_virtual/libgles3:mx95-nxp-bsp   ?= "mali-imx"
	PREFERRED_PROVIDER_opencl-clhpp:mx95-nxp-bsp       ?= "opencl-clhpp"
	PREFERRED_PROVIDER_opencl-headers:mx95-nxp-bsp     ?= "opencl-headers"
	PREFERRED_PROVIDER_opencl-icd-loader:mx95-nxp-bsp  ?= "opencl-icd-loader"
	PREFERRED_PROVIDER_virtual/opencl-icd:mx95-nxp-bsp ?= "opencl-icd-loader"
	PREFERRED_PROVIDER_virtual/libg2d:mx95-nxp-bsp ?= "imx-dpu-g2d"
	CUSTOMER_RECIPES:fsl-bsp-release += 'imx-dpu-g2d'
	CUSTOMER_RECIPES:fsl-bsp-release += 'imx-secure-enclave-seco'
	CUSTOMER_RECIPES:fsl-bsp-release += 'imx-opencl-converter'
	CUSTOMER_RECIPES:fsl-bsp-release += 'mali-imx'
	CUSTOMER_RECIPES:fsl-sdk-release += 'libcamera'
	PREFERRED_VERSION_libcamera:mx95-nxp-bsp = "0.3.0.imx"
	CUSTOMER_RECIPES:openembedded-layer += 'glmark2'

#The following are common configurations

DISTRO_FEATURES:remove = "directfb"
DISTRO_FEATURES:append = " x11 wayland pam"
IMAGE_FEATURES:append = " weston"
IMAGE_FEATURES:remove = "x11-base  x11-sato"
MACHINE_HAS_VIVANTE_KERNEL_DRIVER_SUPPORT = "1"

# QA check settings - a little stricter than the OE-Core defaults
WARN_TO_ERROR_QA = "already-stripped compile-host-path install-host-path \
                    installed-vs-shipped ldflags pn-overrides rpaths staticdev \
                    useless-rpaths"
WARN_QA:remove = "${WARN_TO_ERROR_QA}"
ERROR_QA:append = " ${WARN_TO_ERROR_QA}"

PREFERRED_VERSION_weston:mx9-nxp-bsp = "14.0.2.imx"
PREFERRED_PROVIDER_virtual/libg2d:mx93-nxp-bsp ?= "imx-pxp-g2d"
PREFERRED_VERSION_libdrm:mx9-nxp-bsp = "2.4.127.imx"
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-g2d-samples'
CUSTOMER_RECIPES:fsl-bsp-release += 'mesa'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-pxp-g2d'
CUSTOMER_RECIPES:fsl-bsp-release += 'weston-init'
CUSTOMER_RECIPES:fsl-bsp-release += 'weston'
CUSTOMER_RECIPES:freescale-layer += 'xwayland'
CUSTOMER_RECIPES:fsl-bsp-release += 'linux-imx-headers'
CUSTOMER_RECIPES:fsl-bsp-release += 'libdrm'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-gst1.0-plugin'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-parser'
CUSTOMER_RECIPES:fsl-bsp-release += 'imx-codec'
CUSTOMER_RECIPES:freescale-layer += 'imx-lib'
CUSTOMER_RECIPES:openembedded-layer += 'opencl-icd-loader'
CUSTOMER_RECIPES:openembedded-layer += 'opencl-headers'
